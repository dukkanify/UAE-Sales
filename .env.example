# Stripe (test mode keys from https://dashboard.stripe.com/test/apikeys)
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_CURRENCY=aed

# Local development URL (Stripe redirect URLs)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Session cookie domain — leave empty for localhost
SESSION_COOKIE_DOMAIN=

# Optional — external API (not required for Stripe checkout)
NEXT_PUBLIC_API_BASE_URL=

# Feature flags
NEXT_PUBLIC_ENABLE_UAE_PASS=false
NEXT_PUBLIC_ENABLE_EMAIL_OTP=false
NEXT_PUBLIC_ENABLE_GUEST_CHECKOUT=true
# Show mock-pay CTA in UI (dev/preview only)
NEXT_PUBLIC_ENABLE_MOCK_CHECKOUT=true
# Force server mock path even without Stripe (never set on production)
ALLOW_MOCK_CHECKOUT=false

# Email / OTP — required on Vercel for welcome + OTP mail
# Create a key at https://resend.com and verify sooqna.site (or keep the
# no-reply@sooqna.site from-address after DNS verification).
EMAIL_PROVIDER=resend
EMAIL_FROM_NAME=Sooqna
EMAIL_FROM_ADDRESS=no-reply@sooqna.site
RESEND_API_KEY=
SUPPORT_EMAIL=support@sooqna.site
OTP_EXPIRY_MINUTES=10
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_PEPPER=sooqna-dev-pepper
ENABLE_DEMO_OTP=true
PASSWORD_PEPPER=sooqna-dev-password-pepper

# Web Push (optional). If unset locally, keys are generated and saved under .data/.
# On Vercel set both so notifications reach the browser/phone when the tab is closed.
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
