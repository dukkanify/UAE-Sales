-- =============================================================================
-- AEP — Prisma schema (optional ORM over Supabase PostgreSQL)
-- Generate: npx prisma generate --schema=database/prisma/schema.prisma
-- =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  student
  instructor
  admin
  super_admin

  @@map("user_role")
}

enum AccountStatus {
  pending
  active
  inactive
  suspended

  @@map("account_status")
}

enum NotificationChannel {
  in_app
  email

  @@map("notification_channel")
}

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  key         UserRole @unique
  name        String
  description String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique
  name        String
  description String?
  module      String
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String   @map("role_id") @db.Uuid
  permissionId String   @map("permission_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model Profile {
  id              String        @id @db.Uuid
  email           String        @unique
  firstName       String?       @map("first_name")
  lastName        String?       @map("last_name")
  phone           String?
  countryCode     String?       @map("country_code")
  nationality     String?
  avatarUrl       String?       @map("avatar_url")
  timezone        String        @default("UTC")
  language        String        @default("en")
  role            UserRole      @default(student)
  status          AccountStatus @default(pending)
  emailVerified   Boolean       @default(false) @map("email_verified")
  profileComplete Boolean       @default(false) @map("profile_complete")
  lastLoginAt     DateTime?     @map("last_login_at") @db.Timestamptz(6)
  deletedAt       DateTime?     @map("deleted_at") @db.Timestamptz(6)
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  sessions      Session[]
  notifications Notification[]

  @@index([role])
  @@index([status])
  @@index([email])
  @@index([deletedAt])
  @@map("profiles")
}

model Session {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  tokenHash    String    @unique @map("token_hash")
  userAgent    String?   @map("user_agent")
  ipAddress    String?   @map("ip_address")
  rememberMe   Boolean   @default(false) @map("remember_me")
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  lastActiveAt DateTime  @default(now()) @map("last_active_at") @db.Timestamptz(6)

  user Profile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model Country {
  code     String  @id @db.Char(2)
  name     String
  dialCode String? @map("dial_code")
  active   Boolean @default(true)

  @@map("countries")
}

model Setting {
  key         String   @id
  value       Json     @default("{}")
  category    String   @default("general")
  description String?
  updatedBy   String?  @map("updated_by") @db.Uuid
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("settings")
}

model Notification {
  id        String              @id @default(uuid()) @db.Uuid
  userId    String              @map("user_id") @db.Uuid
  title     String
  body      String
  channel   NotificationChannel @default(in_app)
  type      String              @default("system")
  data      Json                @default("{}")
  readAt    DateTime?           @map("read_at") @db.Timestamptz(6)
  createdAt DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)

  user Profile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("notifications")
}

model ActivityLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  action     String
  entityType String?  @map("entity_type")
  entityId   String?  @map("entity_id")
  metadata   Json     @default("{}")
  ipAddress  String?  @map("ip_address")
  userAgent  String?  @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([actorId])
  @@index([action])
  @@index([createdAt])
  @@map("activity_logs")
}

model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  actorId     String?  @map("actor_id") @db.Uuid
  action      String
  resource    String
  beforeState Json?    @map("before_state")
  afterState  Json?    @map("after_state")
  ipAddress   String?  @map("ip_address")
  userAgent   String?  @map("user_agent")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([actorId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// LMS / Course Management (migration 005)
// ---------------------------------------------------------------------------

enum CourseStatus {
  draft
  published
  private
  scheduled
  archived

  @@map("course_status")
}

enum DifficultyLevel {
  beginner
  intermediate
  advanced
  expert

  @@map("difficulty_level")
}

enum EnrollmentMode {
  open
  private
  invitation
  manual

  @@map("enrollment_mode")
}

enum EnrollmentStatus {
  pending
  approved
  rejected
  completed
  dropped
  suspended

  @@map("enrollment_status")
}

enum ContentStatus {
  draft
  published
  hidden

  @@map("content_status")
}

enum ResourceType {
  pdf
  ppt
  doc
  image
  audio
  link
  zip
  video

  @@map("resource_type")
}

enum InstructorRole {
  primary
  assistant

  @@map("instructor_role")
}

model CourseCategory {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  slug        String   @unique
  description String   @default("")
  parentId    String?  @map("parent_id") @db.Uuid
  icon        String   @default("Folder")
  sortOrder   Int      @default(0) @map("sort_order")
  visible     Boolean  @default(true)
  metadata    Json     @default("{}")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  parent   CourseCategory?  @relation("CategoryTree", fields: [parentId], references: [id])
  children CourseCategory[] @relation("CategoryTree")
  courses  Course[]

  @@map("course_categories")
}

model Course {
  id                        String         @id @default(uuid()) @db.Uuid
  title                     String
  shortDescription          String         @default("") @map("short_description")
  fullDescription           String         @default("") @map("full_description")
  code                      String
  categoryId                String?        @map("category_id") @db.Uuid
  thumbnailUrl              String?        @map("thumbnail_url")
  coverImageUrl             String?        @map("cover_image_url")
  previewVideoUrl           String?        @map("preview_video_url")
  difficulty                DifficultyLevel @default(intermediate)
  language                  String         @default("en")
  estimatedDurationMinutes  Int            @default(0) @map("estimated_duration_minutes")
  enrollmentMode            EnrollmentMode @default(manual) @map("enrollment_mode")
  status                    CourseStatus   @default(draft)
  scheduledPublishAt        DateTime?      @map("scheduled_publish_at") @db.Timestamptz(6)
  primaryInstructorId       String?        @map("primary_instructor_id") @db.Uuid
  tags                      String[]       @default([])
  metadata                  Json           @default("{}")
  createdById               String?        @map("created_by_id") @db.Uuid
  createdAt                 DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                 DateTime       @default(now()) @map("updated_at") @db.Timestamptz(6)
  deletedAt                 DateTime?      @map("deleted_at") @db.Timestamptz(6)
  publishedAt               DateTime?      @map("published_at") @db.Timestamptz(6)
  archivedAt                DateTime?      @map("archived_at") @db.Timestamptz(6)

  category    CourseCategory?      @relation(fields: [categoryId], references: [id])
  instructors CourseInstructor[]
  modules     CourseModule[]
  lessons     Lesson[]
  enrollments Enrollment[]
  progress    LessonProgress[]

  @@index([status])
  @@index([categoryId])
  @@map("courses")
}

model CourseInstructor {
  id         String         @id @default(uuid()) @db.Uuid
  courseId   String         @map("course_id") @db.Uuid
  userId     String         @map("user_id") @db.Uuid
  role       InstructorRole @default(assistant)
  assignedAt DateTime       @default(now()) @map("assigned_at") @db.Timestamptz(6)

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([courseId, userId, role])
  @@map("course_instructors")
}

model CourseModule {
  id                       String        @id @default(uuid()) @db.Uuid
  courseId                 String        @map("course_id") @db.Uuid
  title                    String
  description              String        @default("")
  sortOrder                Int           @default(0) @map("sort_order")
  estimatedDurationMinutes Int           @default(0) @map("estimated_duration_minutes")
  status                   ContentStatus @default(draft)
  visible                  Boolean       @default(true)
  createdAt                DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                DateTime      @default(now()) @map("updated_at") @db.Timestamptz(6)

  course  Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons Lesson[]

  @@index([courseId])
  @@map("course_modules")
}

model Lesson {
  id                    String        @id @default(uuid()) @db.Uuid
  courseId              String        @map("course_id") @db.Uuid
  moduleId              String        @map("module_id") @db.Uuid
  title                 String
  description           String        @default("")
  contentHtml           String        @default("") @map("content_html")
  videoUrl              String?       @map("video_url")
  durationMinutes       Int           @default(0) @map("duration_minutes")
  estimatedStudyMinutes Int           @default(0) @map("estimated_study_minutes")
  sortOrder             Int           @default(0) @map("sort_order")
  previewAvailable      Boolean       @default(false) @map("preview_available")
  status                ContentStatus @default(draft)
  createdAt             DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime      @default(now()) @map("updated_at") @db.Timestamptz(6)

  course    Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  module    CourseModule     @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  resources LessonResource[]
  progress  LessonProgress[]

  @@index([moduleId])
  @@map("lessons")
}

model LessonResource {
  id           String       @id @default(uuid()) @db.Uuid
  lessonId     String       @map("lesson_id") @db.Uuid
  title        String
  type         ResourceType
  url          String
  fileName     String?      @map("file_name")
  mimeType     String?      @map("mime_type")
  sizeBytes    BigInt?      @map("size_bytes")
  downloadable Boolean      @default(true)
  sortOrder    Int          @default(0) @map("sort_order")
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime     @default(now()) @map("updated_at") @db.Timestamptz(6)

  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@map("lesson_resources")
}

model Enrollment {
  id           String           @id @default(uuid()) @db.Uuid
  courseId     String           @map("course_id") @db.Uuid
  studentId    String           @map("student_id") @db.Uuid
  status       EnrollmentStatus @default(pending)
  enrolledById String?          @map("enrolled_by_id") @db.Uuid
  enrolledAt   DateTime         @default(now()) @map("enrolled_at") @db.Timestamptz(6)
  approvedAt   DateTime?        @map("approved_at") @db.Timestamptz(6)
  completedAt  DateTime?        @map("completed_at") @db.Timestamptz(6)
  droppedAt    DateTime?        @map("dropped_at") @db.Timestamptz(6)
  suspendedAt  DateTime?        @map("suspended_at") @db.Timestamptz(6)
  notes        String?
  updatedAt    DateTime         @default(now()) @map("updated_at") @db.Timestamptz(6)

  course   Course          @relation(fields: [courseId], references: [id], onDelete: Cascade)
  progress LessonProgress[]

  @@index([studentId])
  @@index([courseId, status])
  @@map("enrollments")
}

model LessonProgress {
  id               String    @id @default(uuid()) @db.Uuid
  enrollmentId     String    @map("enrollment_id") @db.Uuid
  lessonId         String    @map("lesson_id") @db.Uuid
  courseId         String    @map("course_id") @db.Uuid
  studentId        String    @map("student_id") @db.Uuid
  completed        Boolean   @default(false)
  completedAt      DateTime? @map("completed_at") @db.Timestamptz(6)
  timeSpentSeconds Int       @default(0) @map("time_spent_seconds")
  lastAccessedAt   DateTime? @map("last_accessed_at") @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  enrollment Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  lesson     Lesson     @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  course     Course     @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([enrollmentId, lessonId])
  @@map("lesson_progress")
}
