{
  "name": "aviatorpass",
  "version": "0.1.0",
  "description": "AviatorPass — professional ATPL aviation training platform.",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check \"tests/**/*.{ts,md}\" \"e2e/*.ts\" \"vitest.config.ts\" \"playwright.config.ts\" \".prettierrc.json\" \".lintstagedrc.json\" \"docs/TESTING.md\" \"docs/CODING_STANDARDS.md\" \"docs/GIT_WORKFLOW.md\" \"docs/MODULE_TEMPLATE.md\" \"docs/PERFORMANCE_BENCHMARKS.md\" \"docs/TECHNICAL_DEBT.md\" \"docs/ERROR_MONITORING.md\" \"docs/RELEASE_NOTES.md\"",
    "format:all": "prettier --write .",
    "test": "VITE_CONFIG_NATIVE_IGNORE_WARNING=true vitest run",
    "test:watch": "VITE_CONFIG_NATIVE_IGNORE_WARNING=true vitest",
    "test:coverage": "VITE_CONFIG_NATIVE_IGNORE_WARNING=true vitest run --coverage",
    "test:bench": "VITE_CONFIG_NATIVE_IGNORE_WARNING=true vitest run tests/unit/benchmarks.test.ts",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium",
    "test:all": "npm run test && npm run acceptance",
    "prepare": "husky",
    "backup": "node scripts/backup-data.mjs daily",
    "backup:weekly": "node scripts/backup-data.mjs weekly",
    "backup:monthly": "node scripts/backup-data.mjs monthly",
    "demo:seed": "VITE_CONFIG_NATIVE_IGNORE_WARNING=true vitest run tests/unit/demo-accounts.test.ts",
    "acceptance": "node scripts/acceptance-smoke.mjs",
    "uat": "node scripts/uat-smoke.mjs",
    "git:sync": "bash scripts/git-safe-sync.sh",
    "git:status": "node scripts/git-enterprise-status.mjs",
    "verify:isolation": "node scripts/verify-product-isolation.mjs",
    "db:generate": "prisma generate --schema=database/prisma/schema.prisma",
    "db:push": "prisma db push --schema=database/prisma/schema.prisma",
    "db:studio": "prisma studio --schema=database/prisma/schema.prisma"
  },
  "keywords": [
    "aviation",
    "education",
    "training",
    "pilots",
    "nextjs",
    "supabase"
  ],
  "license": "UNLICENSED",
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-context-menu": "^2.3.7",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-progress": "^1.1.7",
    "@radix-ui/react-radio-group": "^1.4.7",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@supabase/ssr": "^0.7.0",
    "@supabase/supabase-js": "^2.57.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "framer-motion": "^12.23.12",
    "jose": "^6.2.8",
    "lucide-react": "^0.544.0",
    "next": "^15.5.3",
    "next-themes": "^0.4.6",
    "nodemailer": "^9.0.4",
    "qrcode": "^1.5.4",
    "react": "^19.1.1",
    "react-day-picker": "^9.9.0",
    "react-dom": "^19.1.1",
    "react-hook-form": "^7.62.0",
    "recharts": "^2.15.4",
    "sonner": "^2.0.7",
    "stripe": "^18.5.0",
    "tailwind-merge": "^3.3.1",
    "vaul": "^1.1.2",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.1.13",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.18.1",
    "@types/nodemailer": "^8.0.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9.35.0",
    "eslint-config-next": "^15.5.3",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^16.4.0",
    "prettier": "^3.9.6",
    "prisma": "^6.15.0",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.9.2",
    "vitest": "^4.1.10"
  }
}
