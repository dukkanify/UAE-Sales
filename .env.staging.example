# =============================================================================
# Staging — dubai-test.blog (Hostinger DNS → Vercel)
# Copy values into Vercel Project → Settings → Environment Variables
# =============================================================================

NEXT_PUBLIC_APP_URL=https://dubai-test.blog
NEXT_PUBLIC_APP_NAME=AviatorPass
NEXT_PUBLIC_APP_ENV=staging

AUTH_SECRET=replace-with-a-long-random-secret-24chars-min
AUTH_SESSION_DAYS=7
AUTH_REMEMBER_ME_DAYS=30
AUTH_OTP_EXPIRY_MINUTES=10

# Demo OTP OK for staging tests; turn off for public traffic
ENABLE_DEMO_OTP=true
DEMO_OTP_CODE=123456

SUPER_ADMIN_EMAIL=superadmin@eagerpilots.com
SUPER_ADMIN_FIRST_NAME=Super
SUPER_ADMIN_LAST_NAME=Admin

NEXT_PUBLIC_AUTH_REDIRECT_URL=https://dubai-test.blog/auth/callback
NEXT_PUBLIC_MAINTENANCE_MODE=false
NEXT_PUBLIC_ENABLE_REALTIME=true
NEXT_PUBLIC_STORAGE_BUCKET=aep-uploads
