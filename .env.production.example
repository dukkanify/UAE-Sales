# =============================================================================
# Production environment template — copy to .env.production / Vercel env vars
# Never commit real secrets.
# Staging test domain: https://dubai-test.blog — see docs/DOMAIN_DUBAI_TEST.md
# =============================================================================

NEXT_PUBLIC_APP_URL=https://dubai-test.blog
NEXT_PUBLIC_APP_NAME="AviatorPass"
NEXT_PUBLIC_APP_ENV=production

# Required — strong unique secret (≥24 characters)
AUTH_SECRET=

AUTH_SESSION_DAYS=7
AUTH_REMEMBER_ME_DAYS=30
AUTH_OTP_EXPIRY_MINUTES=10

# MUST be false in production
ENABLE_DEMO_OTP=false
# Leave unset in production
# DEMO_OTP_CODE=

SUPER_ADMIN_EMAIL=ops@example.com
SUPER_ADMIN_FIRST_NAME=Super
SUPER_ADMIN_LAST_NAME=Admin

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=
DIRECT_URL=

NEXT_PUBLIC_AUTH_REDIRECT_URL=https://dubai-test.blog/auth/callback
NEXT_PUBLIC_MAINTENANCE_MODE=false
NEXT_PUBLIC_ENABLE_REALTIME=true
NEXT_PUBLIC_STORAGE_BUCKET=aep-uploads

# Zoom (Server-to-Server OAuth)
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_WEBHOOK_SECRET=

# Stripe (prefer restricted keys rk_live_…)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
