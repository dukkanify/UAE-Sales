# Stripe (live mode keys from https://dashboard.stripe.com/apikeys)
STRIPE_SECRET_KEY=sk_live_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_CURRENCY=aed

# Production canonical URL (required at build time for Stripe redirects)
NEXT_PUBLIC_APP_URL=https://sooqna.site

# Session cookie — share across apex and www (www redirects to apex)
SESSION_COOKIE_DOMAIN=.sooqna.site

# Optional — external API
NEXT_PUBLIC_API_BASE_URL=

# Auth persistence — required. Vercel /tmp is ephemeral and must not store users.
# Neon, Vercel Postgres, or any Postgres URL. Existing users.json is imported once
# (insert-only; passwords of existing rows are never overwritten).
DATABASE_URL=postgres://USER:PASSWORD@HOST/DB?sslmode=require
# POSTGRES_URL=

# Feature flags
NEXT_PUBLIC_ENABLE_UAE_PASS=false
NEXT_PUBLIC_ENABLE_EMAIL_OTP=false
NEXT_PUBLIC_ENABLE_GUEST_CHECKOUT=true
# Must stay false in production — real Stripe only
NEXT_PUBLIC_ENABLE_MOCK_CHECKOUT=false
# Never set true on sooqna.site
ALLOW_MOCK_CHECKOUT=false

# Email / OTP (required for production OTP delivery)
EMAIL_PROVIDER=resend
EMAIL_FROM_NAME=Sooqna | سوقنا
EMAIL_FROM_ADDRESS=no-reply@sooqna.site
RESEND_API_KEY=
OTP_EXPIRY_MINUTES=10
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_PEPPER=
PASSWORD_PEPPER=
ENABLE_DEMO_OTP=false

# Web Push — required in production for background browser/mobile alerts
# npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
